<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>{{{title}}}</title>
    <style>
        body {
            margin: 0;
            padding: 0;
        }
        
        header {
            width: 100vw;
            height: 10vh;
            display: flex;
            flex-direction: row;
            justify-content: space-around;
            background-color: rgb(0, 0, 0);
        }

        main {
            width: 100vw;
            height: 90vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: rgb(190, 190, 190);
            }

        a {
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            font-size: 20px;
            font-weight: bold;
            text-decoration: none;
            border-right: 3px solid white;
            padding-right: 50px;
            padding-left: 50px;
            width: 20%;
        }

        a:last-of-type {
            border-right: none;
        }

        #root {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            width: 500px;
            height: 500px;
            background-color: rgb(255, 255, 255);
            border-radius: 10%;
        }
    </style>
</head>
<body>
    <header>
        <a href="/">HOME</a>
        <a href="first">First</a>
        <a href="second">Second</a>
        <a href="third">Third</a>
    </header>
    <main>
    <div id="root">
        {{{body}}}
    </div>
    </main>
</body>
</html>